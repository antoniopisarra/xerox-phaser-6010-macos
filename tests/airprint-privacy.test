{
 NAME "Submit a harmless named privacy fixture"
 OPERATION Print-Job
 GROUP operation-attributes-tag
 ATTR charset attributes-charset utf-8
 ATTR language attributes-natural-language en
 ATTR uri printer-uri $uri
 ATTR mimeMediaType document-format application/pdf
 ATTR name requesting-user-name review-private-user
 GROUP job-attributes-tag
 ATTR name job-name review-private-document
 FILE $filename
 STATUS successful-ok
 STATUS successful-ok-ignored-or-substituted-attributes
}
{
 NAME "Job history redacts document titles and users"
 OPERATION Get-Jobs
 GROUP operation-attributes-tag
 ATTR charset attributes-charset utf-8
 ATTR language attributes-natural-language en
 ATTR uri printer-uri $uri
 ATTR keyword which-jobs all
 ATTR keyword requested-attributes job-name,job-originating-user-name,job-id,job-state
 STATUS successful-ok
 EXPECT job-name WITH-VALUE "AirPrint document"
 EXPECT job-originating-user-name WITH-VALUE anonymous
}
